# ============================================================================
# 环境变量模板 —— 复制为 .env 后按需填写（.env 已被 .gitignore 排除）
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 基础
# ----------------------------------------------------------------------------
APP_NAME=中医药智慧康养系统
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# 服务监听
HOST=127.0.0.1
PORT=8000

# CORS（开发期放开；生产请收紧为具体域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ----------------------------------------------------------------------------
# 数据库
#   sqlite:///D:/herbal/var/app.db    开发期（默认）
#   mysql+pymysql://user:pwd@127.0.0.1:3306/herbai   答辩/演示期（需另装 pymysql）
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///D:/herbal/var/app.db

# LangGraph Checkpointer 快照库（P2 会话中断恢复；丢失也不影响，DB 有问卷快照兜底）
CHECKPOINT_DB_PATH=D:/herbal/var/langgraph_ckpt.sqlite

# ----------------------------------------------------------------------------
# LLM provider（ADR-003：供应商解耦）
#   可选：ollama | deepseek | zhipu | mock
#   mock 为离线自检 Provider，不联网、不花钱，用于在无 Ollama 环境下验证流程
# ----------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# deepseek 主力 API（付费，月预算见下）——留空即视为不可用，会自动降级
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 关键环节（追问决策 / 方案生成）可切 reasoner，配置开关
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
USE_REASONER_FOR_KEY_STEPS=false

# 智谱免费档兜底
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# Ollama 本地兜底（答辩断网演示用）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# 降级链：主 provider 失败时依次尝试（逗号分隔，留空表示不自动降级）
LLM_FALLBACK_CHAIN=ollama,mock

# ----------------------------------------------------------------------------
# 成本护栏（ADR-003）
# ----------------------------------------------------------------------------
# 月度 LLM 预算（元），达到 80% 告警，达到 100% 自动切降级链
MONTHLY_BUDGET_CNY=200.0
# 计费单价，元 / 千 token（deepseek-chat 约为该量级，按实际价格调整）
PRICE_PER_1K_PROMPT_CNY=0.002
PRICE_PER_1K_COMPLETION_CNY=0.008

# ----------------------------------------------------------------------------
# 数据文件（相对 backend/data/）
# ----------------------------------------------------------------------------
HERBS_828_PATH=data/tcm_828_herbs.json
FOOD_MEDICINE_PATH=data/food_medicine_106.json
# 规则表版本（写入推荐结果，便于论文复现与回溯）
RULE_TABLE_VERSION=v0.1-draft

# ----------------------------------------------------------------------------
# RAG 检索增强（P3）
# ----------------------------------------------------------------------------
# 总开关：关闭后所有节点退回「无检索上下文」模式，流程不中断
RAG_ENABLED=true

# 向量化器：sentence-onnx | tfidf-char | hashing-bigram
#   sentence-onnx  需 sentence-transformers + onnxruntime 与本地模型（RAG_MODEL_PATH）
#   tfidf-char     需 scikit-learn；字面相似，中文同义泛化弱
#   hashing-bigram 零依赖兜底，确定性可复现（构建/查询必须用同一分词与归一化）
# 启动按 sentence-onnx -> tfidf-char -> hashing-bigram 自动降级
RAG_EMBEDDER=hashing-bigram

# 向量库：chroma | memory
#   chroma 需 chromadb（持久化到 RAG_CHROMA_DIR）
#   memory 纯内存 + JSONL 落盘，零依赖
RAG_VECTOR_STORE=chroma

# 知识库切片文件（由 scripts/build_kb.py 生成）
RAG_KB_PATH=data/kb/chunks.jsonl
# 索引持久化目录（TF-IDF 词表/IDF、hashing IDF 等状态）
RAG_INDEX_PATH=var/rag_index
RAG_CHROMA_DIR=var/chroma
RAG_COLLECTION=tcm_kb
# sentence-onnx 本地模型目录（留空则跳过该档）
RAG_MODEL_PATH=

# 检索召回条数（语义 + 关键词融合后 RRF 取前 N）
RAG_TOP_K=8
# 最终拼进 Prompt 的切片条数（控制 token）
RAG_CONTEXT_CHUNKS=5

# ----------------------------------------------------------------------------
# 安全
# ----------------------------------------------------------------------------
# 急症拦截后是否仍然落库留痕
PERSIST_BLOCKED_CONSULTATION=true
# 健康数据加密密钥（MVP 未启用加密存储，预留）
APP_SECRET_KEY=change-me-in-production

# ----------------------------------------------------------------------------
# 认证（P6 · 清单 5.4.1：注册 / 登录 / JWT）
# ----------------------------------------------------------------------------
# JWT 签名密钥；留空时回落 APP_SECRET_KEY。生产环境务必填独立强随机值：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# access token 寿命（分钟）：短寿命缩小泄露窗口
JWT_ACCESS_EXPIRE_MINUTES=120
# refresh token 寿命（天）：仅用于 /auth/refresh 换新，不能访问业务接口
JWT_REFRESH_EXPIRE_DAYS=14
