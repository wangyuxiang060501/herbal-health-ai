  "components": {
    "schemas": {
      "ConsultationAnswerIn": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer",
            "description": "用户对追问的回答"
          },
          "top_n": {
            "type": "integer",
            "title": "Top N",
            "default": 6
          },
          "enable_recipe": {
            "type": "boolean",
            "title": "Enable Recipe",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "ConsultationAnswerIn"
      },
      "ConsultationStartIn": {
        "properties": {
          "chief_complaint": {
            "type": "string",
            "title": "Chief Complaint",
            "description": "用户自由描述的主诉",
            "default": ""
          },
          "questionnaire": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Questionnaire",
            "description": "{question_id: 1-5 分}"
          },
          "special_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Special Groups",
            "description": "孕妇 / 哺乳期 / 儿童 / 慢性病患者"
          },
          "top_n": {
            "type": "integer",
            "title": "Top N",
            "default": 6
          },
          "enable_recipe": {
            "type": "boolean",
            "title": "Enable Recipe",
            "description": "是否启用 Agent3 药膳生成节点（P3，默认关闭）",
            "default": false
          }
        },
        "type": "object",
        "title": "ConsultationStartIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginIn": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^1[3-9]\\d{9}$",
            "title": "Phone"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "title": "LoginIn"
      },
      "OutputProbeIn": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "OutputProbeIn"
      },
      "RefreshIn": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 10,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshIn"
      },
      "RegisterIn": {
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^1[3-9]\\d{9}$",
            "title": "Phone",
            "description": "11 位手机号"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 6,
            "title": "Password",
            "description": "至少 6 位"
          },
          "nickname": {
            "type": "string",
            "maxLength": 50,
            "title": "Nickname",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "title": "RegisterIn"
      },
      "SafetyProbeIn": {
        "properties": {
